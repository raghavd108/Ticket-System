PORT=3002
JWT_SECRET=your_jwt_secret_here
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_BASE_URL=https://ik.imagekit.io/your_imagekit_id
DATABASE_URL="mysql://<db_name>:<db_password>@localhost:3306/<db_name>"
SHADOW_DATABASE_URL="mysql://<db_name>:<db_password>@localhost:3306/<db_name>_shadow"
Firebase_path=firebase_service_account.json
NODE_ENV=production
