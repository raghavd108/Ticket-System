generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  client
  employee
}

enum AttendanceStatus {
  present
  absent
  late
  leave
  holiday
}

enum NotificationType {
  NEW_TICKET
  STATUS_UPDATE
  CUSTOM
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum CalendarDayType {
  HOLIDAY
  WORKING_DAY
}

model Organisation {
  id        String   @id @default(cuid())
  orgType   String
  name      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator    User?       @relation("OrganisationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  users      User[]      @relation("OrganisationUsers")
  complaints Complaint[]

  @@index([createdBy])
}

model User {
  id             String  @id @default(cuid())
  userName       String  @unique
  email          String
  mobileNumber   String?
  password       String
  role           Role
  organisationId String
  designation    String?
  fcmToken       String?
  tokenVersion   Int     @default(0)

  // Account access revocation
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organisation relations
  organisation Organisation @relation("OrganisationUsers", fields: [organisationId], references: [id], onDelete: Restrict)

  // Employee designations are managed in the Designation table.
  designationRef       Designation?   @relation(fields: [designation], references: [name], onDelete: Restrict, onUpdate: Cascade)
  organisationsCreated Organisation[] @relation("OrganisationCreator")

  // Client and employee assignments
  assignedEmployees UserAssignment[] @relation("ClientAssignments")
  assignedToClients UserAssignment[] @relation("EmployeeAssignments")

  // Application relations
  complaints         Complaint[]
  assignedComplaints Complaint[]    @relation("ComplaintAssignedEmployee")
  documents          Document[]
  attendance         Attendance[]
  notifications      Notification[]
  leaves             Leave[]

  @@index([organisationId])
  @@index([email])
  @@index([role])
  @@index([isRevoked])
  @@index([designation])
}

// Employee designations and the ticket permissions they grant.
model Designation {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  canViewAllTickets Boolean  @default(false)
  canAssignTickets  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users User[]
}

// Ticket workflow statuses. Defaults are seeded by prisma/seed.js.
model TicketStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[]
}

model UserAssignment {
  clientId   String
  employeeId String
  createdAt  DateTime @default(now())

  client   User @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  employee User @relation("EmployeeAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([clientId, employeeId])
  @@index([employeeId])
}

model Complaint {
  id                 String   @id @default(cuid())
  module             String
  problem            String   @db.Text
  userId             String
  organisationId     String
  assignedEmployeeId String?  @db.VarChar(191)
  statusId           Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  status       TicketStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  assignedEmployee User? @relation("ComplaintAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  images        ComplaintImage[]
  notifications Notification[]

  @@index([userId])
  @@index([organisationId, statusId])
  @@index([statusId, createdAt])
  @@index([assignedEmployeeId])
}

model ComplaintImage {
  id          String @id @default(cuid())
  complaintId String
  fileName    String

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model Document {
  id         String   @id @default(cuid())
  employeeId String
  title      String   @db.VarChar(191)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee User           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  files    DocumentFile[]

  @@index([employeeId])
}

model DocumentFile {
  id           String  @id @default(cuid())
  documentId   String
  fileName     String
  originalName String
  mimeType     String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  inTime     DateTime?
  outTime    DateTime?
  location   String           @default("") @db.VarChar(191)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([date])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  title       String
  body        String           @db.Text
  type        NotificationType
  read        Boolean          @default(false)
  complaintId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([complaintId])
}

model Leave {
  id         String      @id @default(cuid())
  employeeId String
  leaveType  String
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String      @db.Text
  status     LeaveStatus @default(pending)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
}

model CompanyCalendarDay {
  id          String          @id @default(cuid())
  date        DateTime        @unique @db.Date
  type        CalendarDayType
  name        String          @db.VarChar(191)
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, date])
}
