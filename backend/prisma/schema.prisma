generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum Role {
  admin
  client
  employee
}

enum AttendanceStatus {
  present
  absent
  late
  leave
  holiday
}

enum NotificationType {
  NEW_TICKET
  STATUS_UPDATE
  CUSTOM
  OFFER
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum CalendarDayType {
  HOLIDAY
  WORKING_DAY
}

enum OfferStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OfferAudienceType {
  ALL_CLIENTS
  ORGANISATION_CATEGORIES
  SELECTED_ORGANISATIONS
}

// =====================================================
// ORGANISATION
// =====================================================

model Organisation {
  id        String   @id @default(cuid())
  orgType   String
  name      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator        User?               @relation("OrganisationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  users          User[]              @relation("OrganisationUsers")
  complaints     Complaint[]
  targetedOffers OfferOrganisation[]

  @@index([createdBy])
  @@index([orgType])
}

// =====================================================
// USER
// =====================================================

model User {
  id             String  @id @default(cuid())
  userName       String  @unique
  email          String
  mobileNumber   String?
  password       String
  role           Role
  organisationId String
  designation    String?
  fcmToken       String?
  tokenVersion   Int     @default(0)

  isSuperAdmin Boolean @default(false)

  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation @relation("OrganisationUsers", fields: [organisationId], references: [id], onDelete: Restrict)
  designationRef Designation? @relation(fields: [designation], references: [name], onDelete: Restrict, onUpdate: Cascade)

  organisationsCreated Organisation[] @relation("OrganisationCreator")

  assignedEmployees UserAssignment[] @relation("ClientAssignments")
  assignedToClients UserAssignment[] @relation("EmployeeAssignments")

  complaints         Complaint[]
  assignedComplaints Complaint[]    @relation("ComplaintAssignedEmployee")
  documents          Document[]
  attendance         Attendance[]
  notifications      Notification[]
  leaves             Leave[]

  offersCreated Offer[] @relation("OfferCreator")

  @@index([organisationId])
  @@index([email])
  @@index([role])
  @@index([isRevoked])
  @@index([isSuperAdmin])
  @@index([designation])
}

// =====================================================
// DESIGNATION AND PERMISSIONS
// =====================================================

model Designation {
  id   Int    @id @default(autoincrement())
  name String @unique

  canViewAllTickets Boolean @default(false)
  canAssignTickets  Boolean @default(false)
  canManageUsers    Boolean @default(false)

  canPublishOffers Boolean @default(false)

  // Employee notification permission
  canNotifyEmployees Boolean @default(false)

  managementLevel Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// =====================================================
// TICKET STATUS
// =====================================================

model TicketStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[]
}

// =====================================================
// USER ASSIGNMENT
// =====================================================

model UserAssignment {
  clientId   String
  employeeId String
  createdAt  DateTime @default(now())

  client   User @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  employee User @relation("EmployeeAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([clientId, employeeId])
  @@index([employeeId])
}

// =====================================================
// COMPLAINT / TICKET
// =====================================================

model Complaint {
  id                 String   @id @default(cuid())
  module             String
  problem            String   @db.Text
  userId             String
  organisationId     String
  assignedEmployeeId String?  @db.VarChar(191)
  statusId           Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  status       TicketStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  assignedEmployee User? @relation("ComplaintAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  images        ComplaintImage[]
  notifications Notification[]

  @@index([userId])
  @@index([organisationId, statusId])
  @@index([statusId, createdAt])
  @@index([assignedEmployeeId])
}

// =====================================================
// COMPLAINT IMAGES
// =====================================================

model ComplaintImage {
  id          String @id @default(cuid())
  complaintId String
  fileName    String

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

// =====================================================
// DOCUMENTS
// =====================================================

model Document {
  id         String   @id @default(cuid())
  employeeId String
  title      String   @db.VarChar(191)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee User           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  files    DocumentFile[]

  @@index([employeeId])
}

// =====================================================
// DOCUMENT FILES
// =====================================================

model DocumentFile {
  id           String  @id @default(cuid())
  documentId   String
  fileName     String
  originalName String
  mimeType     String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// =====================================================
// ATTENDANCE
// =====================================================

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  inTime     DateTime?
  outTime    DateTime?
  location   String           @default("") @db.VarChar(191)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([date])
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id     String           @id @default(cuid())
  userId String
  title  String
  body   String           @db.Text
  type   NotificationType
  read   Boolean          @default(false)

  complaintId String?
  offerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  offer     Offer?     @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([userId, read])
  @@index([complaintId])
  @@index([offerId])
}

// =====================================================
// LEAVE
// =====================================================

model Leave {
  id         String      @id @default(cuid())
  employeeId String
  leaveType  String
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String      @db.Text
  status     LeaveStatus @default(pending)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
}

// =====================================================
// COMPANY CALENDAR
// =====================================================

model CompanyCalendarDay {
  id          String          @id @default(cuid())
  date        DateTime        @unique @db.Date
  type        CalendarDayType
  name        String          @db.VarChar(191)
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, date])
}

// =====================================================
// CLIENT OFFERS
// =====================================================

model Offer {
  id          String  @id @default(cuid())
  title       String  @db.VarChar(191)
  description String? @db.Text

  status   OfferStatus       @default(DRAFT)
  audience OfferAudienceType

  expiresAt   DateTime?
  publishedAt DateTime?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation("OfferCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  images        OfferImage[]
  categories    OfferCategory[]
  organisations OfferOrganisation[]
  notifications Notification[]

  @@index([status, publishedAt])
  @@index([expiresAt])
  @@index([createdBy])
  @@index([audience])
}

// =====================================================
// OFFER IMAGES
// =====================================================

model OfferImage {
  id       String @id @default(cuid())
  offerId  String
  fileName String

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

// =====================================================
// OFFER TARGET CATEGORIES
// =====================================================

model OfferCategory {
  id       String @id @default(cuid())
  offerId  String
  category String @db.VarChar(191)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, category])
  @@index([category])
}

// =====================================================
// OFFER TARGET ORGANISATIONS
// =====================================================

model OfferOrganisation {
  id             String @id @default(cuid())
  offerId        String
  organisationId String

  offer        Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([offerId, organisationId])
  @@index([organisationId])
}
