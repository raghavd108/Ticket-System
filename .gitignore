```gitignore
# ==========================================
# Environment Variables
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Firebase Service Account Credentials
# Ignore Firebase Admin SDK private keys
# ==========================================
*firebase-adminsdk*.json
*serviceAccount*.json
*service-account*.json
firebase*.json
serviceAccountKey.json

# Firebase credentials in backend services
backend/src/services/ticket-b8771-firebase-adminsdk-fbsvc-aa26b6ffce.json

# ==========================================
# Dependencies
# ==========================================
node_modules/
**/node_modules/

# ==========================================
# Logs
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# Build & Generated Files
# ==========================================
dist/
build/
coverage/
.next/
.expo/

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# IDE & Editor Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
